# Frontend (Node, Vite, React)
# ------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# Backend (temporarily ignored)
# ------------------------------------------
backend/

*$py.class
*.so

# Environments & Virtualenvs
.env
*.env
backend/.env
backend/config/env/.env
.venv/
backend/.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Django files & media
*.log
debug.log
debug.log.*
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
backend/media/
staticfiles/
backend/staticfiles/

# Celery
celerybeat-schedule
celerybeat.pid

# Unit test / Coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# Packaging / Distribution
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------
