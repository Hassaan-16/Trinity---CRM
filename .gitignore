# ==============================================================================
# Unified .gitignore — Trinity Aviation Academy Platform
# Comprehensive rules for Root, Frontend (React/Vite), and Backend (Django 5/DRF)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & Sensitive Credentials
# ------------------------------------------------------------------------------
.env
*.env
.env.*
!.env.example
!*.env.example

backend/.env
backend/config/env/.env
backend/config/env/.test
backend/config/env/infisical
!backend/config/env/infisical.example

frontend/.env
frontend/.env.*
!frontend/.env.example

*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.secret
secrets/
credentials.json
client_secret*.json
google-credentials*.json

# ------------------------------------------------------------------------------
# 2. Databases, Local Storage & Persistent Volumes
# ------------------------------------------------------------------------------
*.sqlite3
*.sqlite3-journal
db.sqlite3
backend/db.sqlite3
*.db
/data/
backend/data/
certbot/
data/certbot/

# ------------------------------------------------------------------------------
# 3. Logs & Diagnostics
# ------------------------------------------------------------------------------
*.log
*.log.*
debug.log
debug.log.*
backend/debug.log
backend/debug.log.*
pip-log.txt
pip-delete-this-directory.txt

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Celery
celerybeat-schedule
celerybeat.pid

# ------------------------------------------------------------------------------
# 4. Python Bytecode, Caches & Packaging
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 5. Virtual Environments
# ------------------------------------------------------------------------------
.venv/
backend/.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 6. Testing, Quality & Coverage
# ------------------------------------------------------------------------------
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.dmypy.json
dmypy.json
local_settings.py

# ------------------------------------------------------------------------------
# 7. Django Static & Media Uploads
# ------------------------------------------------------------------------------
media/
backend/media/
staticfiles/
backend/staticfiles/

# ------------------------------------------------------------------------------
# 8. Frontend (Node.js / Vite / React)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/
*.local

# ------------------------------------------------------------------------------
# 9. Reference Assets & Examples
# ------------------------------------------------------------------------------
examples/
example/

# ------------------------------------------------------------------------------
# 10. IDE, Editor & OS Artifacts
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
.cursor/
backend/.cursor/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# Temporary / Scratch Office files
test.docx
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp
*.temp
